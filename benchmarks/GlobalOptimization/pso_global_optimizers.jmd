---
title: GPU Particle Swarm Global Optimizer Benchmarks
author: 
---

In this benchmark we compare GPU-accelerated PSO variants from
[ParallelParticleSwarms.jl](https://github.com/SciML/ParallelParticleSwarms.jl)
against established CPU global optimizers on the
[BlackBoxOptimizationBenchmarking.jl](https://github.com/jonathanBieler/BlackBoxOptimizationBenchmarking.jl)
suite, using the [Optimization.jl](https://github.com/SciML/Optimization.jl) interface.
This extends the reference
[Black-Box Global Optimizer Benchmarks](https://docs.sciml.ai/SciMLBenchmarksOutput/stable/GlobalOptimization/blackbox_global_optimizers/)
with GPU-parallel methods from the
[ICLR 2024 workshop paper](https://openreview.net/pdf?id=nD10o1ge97).
GPU-PSO evaluates `num_particles` objective functions simultaneously in a single
kernel launch, so **wall-clock time** is the key metric.

## Setup
```julia
using BlackBoxOptimizationBenchmarking, Optimization, Memoize, Statistics, Random
import BlackBoxOptimizationBenchmarking: Chain, BenchmarkSetup, BenchmarkResults,
    BBOBFunction, FunctionCallsCounter, solve_problem, pinit, compute_CI
const BBOB = BlackBoxOptimizationBenchmarking

using OptimizationBBO, OptimizationOptimJL, OptimizationNLopt
using OptimizationMetaheuristics, OptimizationOptimisers
using OptimizationSciPy

using ParallelParticleSwarms
using KernelAbstractions: CPU
using StaticArrays, LinearAlgebra
using CUDA

# using Plots

const PSOKernel = ParallelParticleSwarms.ParallelPSOKernel
const SyncPSOKernel = ParallelParticleSwarms.ParallelSyncPSOKernel
const SerPSO = ParallelParticleSwarms.SerialPSO
const PSOArray = ParallelParticleSwarms.ParallelPSOArray
const HPso = ParallelParticleSwarms.HybridPSO

include("bbo_gpu.jl")

@info "CUDA" functional=CUDA.functional() gpu=CUDA.name(CUDA.device())
```

We define a time-to-success framework for CPU baselines. For each (optimizer,
function, trial), we run with a large iteration budget and wrap the objective
to detect the first evaluation achieving the success criterion, recording wall
time. GPU kernels cannot use `time()` inside the objective, so PSO time-to-success
is measured externally via `@elapsed` at each iteration budget.
```julia
function make_success_tracker(f_raw, f_opt, Δf)
    t0 = Ref(time())
    time_to_success = Ref(Inf)
    function tracked_f(u)
        val = f_raw(u)
        if val < Δf + f_opt && time_to_success[] == Inf
            time_to_success[] = time() - t0[]
        end
        return val
    end
    return tracked_f, t0, time_to_success
end

function solve_problem_timed(optimizer::BenchmarkSetup, tracked_f, D::Int, run_length::Int;
    u0 = pinit(D))
    method = optimizer.method
    optf = OptimizationFunction((u, _) -> tracked_f(u), AutoForwardDiff())
    if optimizer.isboxed
        prob = OptimizationProblem(optf, u0, lb = fill(-5.5, D), ub = fill(5.5, D))
    else
        prob = OptimizationProblem(optf, u0)
    end
    solve(prob, method; maxiters = run_length)
end

function solve_problem_timed(m::Chain, tracked_f, D::Int, run_length::Int)
    rl1 = round(Int, m.p * run_length)
    rl2 = run_length - rl1
    sol = solve_problem_timed(m.first, tracked_f, D, rl1)
    solve_problem_timed(m.second, tracked_f, D, rl2; u0 = sol.u)
end

function benchmark_time_to_success(
    optimizer::Union{Chain, BenchmarkSetup}, f::BBOBFunction;
    Ntrials::Int = 20, dimension::Int = 3, Δf::Real = 1e-6, max_run_length::Int = 100_000)
    times = Float64[]
    for _ in 1:Ntrials
        tracked_f, t0_ref, tts_ref = make_success_tracker(f.f, f.f_opt, Δf)
        try
            t0_ref[] = time()
            solve_problem_timed(optimizer, tracked_f, dimension, max_run_length)
            push!(times, tts_ref[])
        catch err
            push!(times, Inf)
            @warn(string(optimizer, " failed: ", err))
        end
    end
    times
end

benchmark_time_to_success(optimizer, f; kwargs...) =
    benchmark_time_to_success(BenchmarkSetup(optimizer), f; kwargs...)

function benchmark_time_to_success(
    optimizer::Union{Chain, BenchmarkSetup}, funcs::Vector{BBOBFunction};
    Ntrials::Int = 20, dimension::Int = 3, Δf::Real = 1e-6, max_run_length::Int = 100_000)
    all_times = Float64[]
    for f in funcs
        append!(all_times, benchmark_time_to_success(
            optimizer, f; Ntrials, dimension, Δf, max_run_length))
    end
    all_times
end

benchmark_time_to_success(optimizer, funcs::Vector{BBOBFunction}; kwargs...) =
    benchmark_time_to_success(BenchmarkSetup(optimizer), funcs; kwargs...)

function success_rate_cdf(all_times::Vector{Float64}, time_thresholds::AbstractVector{Float64})
    N = length(all_times)
    [count(x -> x <= t, all_times) / N for t in time_thresholds]
end
```

PSO benchmark harness: same output shape as `BBOB.BenchmarkResults` so both
can go on the same plots. Also stores per-trial `@elapsed` times and hits
for the wall-clock CDF.
```julia
const Δf_pso = 1f-6

function pso_solve(opt, func, lb, ub, maxiters)
    obj = (x, p) -> func(x)
    ad = opt isa HPso ? AutoForwardDiff() : Optimization.SciMLBase.NoAD()
    optf = OptimizationFunction{false}(obj, ad)
    N = length(lb)
    x0 = SVector{N}(ntuple(i -> lb[i] + rand(Float32) * (ub[i] - lb[i]), Val(N)))
    prob = OptimizationProblem{false}(optf, x0, nothing; lb = lb, ub = ub)
    if opt isa HPso
        solve(prob, opt; maxiters = maxiters, local_maxiters = 30)
    else
        solve(prob, opt; maxiters = maxiters)
    end
end

function pso_benchmark(opt, suite, run_length;
        Ntrials = 40, lb = nothing, ub = nothing)
    Nf = length(suite)
    Nr = length(run_length)
    success = zeros(Float64, Nf, Nr)
    dist    = zeros(Float64, Nf, Nr)
    raw_times = zeros(Float64, Nf, Nr, Ntrials)
    raw_hits  = falses(Nf, Nr, Ntrials)

    t0 = time()
    for (fi, func) in enumerate(suite)
        try pso_solve(opt, func, lb, ub, 5) catch; end
        for (ri, rl) in enumerate(run_length)
            hits = 0; dsum = 0.0
            for ti in 1:Ntrials
                t = @elapsed sol = try pso_solve(opt, func, lb, ub, rl) catch; nothing end
                raw_times[fi, ri, ti] = t
                if sol !== nothing
                    fval = Float64(sol.objective)
                    ok = abs(fval - Float64(func.f_opt)) < Δf_pso
                    raw_hits[fi, ri, ti] = ok
                    hits += ok ? 1 : 0
                    dsum += norm(Float64.(sol.u) .- Float64.(func.x_opt))
                end
            end
            success[fi, ri] = hits / Ntrials
            dist[fi, ri]    = dsum / Ntrials
        end
    end

    (run_length              = run_length,
     success_rate            = vec(mean(success, dims = 1)),
     success_rate_per_function = success[:, end],
     distance_to_minimizer   = vec(mean(dist, dims = 1)),
     runtime                 = time() - t0,
     raw_times               = raw_times,
     raw_hits                = raw_hits)
end

function extract_tts(r)
    Nf, Nr, Nt = size(r.raw_times)
    times = Float64[]
    for fi in 1:Nf, ti in 1:Nt
        tts = Inf
        for ri in 1:Nr
            if r.raw_hits[fi, ri, ti]
                tts = r.raw_times[fi, ri, ti]
                break
            end
        end
        push!(times, tts)
    end
    times
end
```
```julia
chain = (t; isboxed = false) -> Chain(
    BenchmarkSetup(t, isboxed = isboxed),
    BenchmarkSetup(NelderMead(), isboxed = false),
    0.9)

test_functions = BBOB.list_functions()
dimension = 3
run_length = round.(Int, 10 .^ LinRange(1, 5, 30))

const DIM_PSO = 3
suite, fnames = gpu_bbob_suite(Val(DIM_PSO))
lb_pso = SVector{DIM_PSO}(ntuple(_ -> -5f0, Val(DIM_PSO)))
ub_pso = SVector{DIM_PSO}(ntuple(_ ->  5f0, Val(DIM_PSO)))
num_particles = 5000

cpu_setup = Dict(
    "NelderMead" => NelderMead(),
    "NLopt CRS2" => chain(NLopt.GN_CRS2_LM(), isboxed = true),
    "NLopt DIRECT" => chain(NLopt.GN_DIRECT(), isboxed = true),
    "NLopt ESCH" => chain(NLopt.GN_ESCH(), isboxed = true),
    "BBO adaptive DE" => chain(BBO_adaptive_de_rand_1_bin(), isboxed = true),
    "BBO DE rand2" => chain(BBO_de_rand_2_bin(), isboxed = true),
    "BBO separable NES" => chain(BBO_separable_nes(), isboxed = true),
    "Metaheuristics DE" => chain(OptimizationMetaheuristics.DE(), isboxed = true),
    "Metaheuristics ECA" => chain(OptimizationMetaheuristics.ECA(), isboxed = true),
    "SciPy DE" => chain(ScipyDifferentialEvolution(), isboxed = true),
    "SciPy SHGO" => chain(ScipyShgo(), isboxed = true),
    "SciPy DIRECT" => chain(ScipyDirect(), isboxed = true),
)

pso_setup = Dict(
    "SerialPSO (CPU)"       => SerPSO(num_particles),
    "PSOKernel sync (CPU)"  => PSOKernel(num_particles; backend = CPU(), global_update = true),
    "SyncPSOKernel (CPU)"   => SyncPSOKernel(num_particles; backend = CPU()),
    "HybridPSO-LBFGS (CPU)" => HPso(pso = PSOKernel(num_particles; backend = CPU()); backend = CPU()),
    "PSOKernel sync (GPU)"  => PSOKernel(num_particles; backend = CUDABackend(), global_update = true),
    "PSOKernel async (GPU)" => PSOKernel(num_particles; backend = CUDABackend(), global_update = false),
    "SyncPSOKernel (GPU)"   => SyncPSOKernel(num_particles; backend = CUDABackend()),
    "HybridPSO-LBFGS (GPU)" => HPso(pso = PSOKernel(num_particles; backend = CUDABackend()); backend = CUDABackend()),
)

cpu_labels = collect(keys(cpu_setup))
pso_labels = collect(keys(pso_setup))
all_labels = vcat(cpu_labels, pso_labels)

@memoize run_cpu_bench(algo) = BBOB.benchmark(
    cpu_setup[algo], test_functions, run_length, Ntrials = 40, dimension = dimension)
@memoize run_cpu_tts(algo) = benchmark_time_to_success(
    cpu_setup[algo], test_functions, Ntrials = 40, dimension = dimension)
@memoize run_pso_bench(algo) = pso_benchmark(
    pso_setup[algo], suite, run_length; Ntrials = 40, lb = lb_pso, ub = ub_pso)
```

