)

pso_setup = Dict(
    # "SerialPSO (CPU)"       => SerPSO(num_particles),
    # "PSOKernel sync (CPU)"  => PSOKernel(num_particles; backend = CPU(), global_update = true),
    # "SyncPSOKernel (CPU)"   => SyncPSOKernel(num_particles; backend = CPU()),
    # "HybridPSO-LBFGS (CPU)" => HPso(pso = PSOKernel(num_particles; backend = CPU()); backend = CPU()),
    "PSOKernel sync (GPU)"  => PSOKernel(num_particles; backend = CUDABackend(), global_update = true),
    "PSOKernel async (GPU)" => PSOKernel(num_particles; backend = CUDABackend(), global_update = false),
    "SyncPSOKernel (GPU)"   => SyncPSOKernel(num_particles; backend = CUDABackend()),
    "HybridPSO-LBFGS (GPU)" => HPso(pso = PSOKernel(num_particles; backend = CUDABackend()); backend = CUDABackend()),
)

cpu_labels = collect(keys(cpu_setup))
pso_labels = collect(keys(pso_setup))
all_labels = vcat(cpu_labels, pso_labels)

# @memoize run_cpu_bench(algo) = BBOB.benchmark(
#     cpu_setup[algo], test_functions, run_length, Ntrials = 40, dimension = dimension)
# @memoize run_cpu_tts(algo) = benchmark_time_to_success(
#     cpu_setup[algo], test_functions, Ntrials = 40, dimension = dimension)
@memoize run_pso_bench(algo) = pso_benchmark(
    pso_setup[algo], suite, run_length; Ntrials = 10, lb = lb_pso, ub = ub_pso)
```

## Test one optimizer
```julia
@time b = pso_benchmark(
    PSOKernel(num_particles; backend = CUDABackend(), global_update = true),
    suite[1:3], run_length[1:5]; Ntrials = 5, lb = lb_pso, ub = ub_pso)

@info "quick test" success=round(b.success_rate[end], digits = 3) time=round(b.runtime, sigdigits = 3)
```

## Test one test function (Rosenbrock)
```julia
f = suite[8]
opt_single = PSOKernel(num_particles; backend = CUDABackend(), global_update = true)

sols = [pso_solve(opt_single, f, lb_pso, ub_pso, 500) for _ in 1:10]
@info "losses" [round(Float64(sol.objective), sigdigits = 4) for sol in sols]
@info "success" [abs(Float64(sol.objective) - Float64(f.f_opt)) < Δf_pso for sol in sols]
```

## Test all (iterations)
```julia
# cpu_results = Dict{String, Any}()
# for algo in cpu_labels
#     @info "Running $algo ..."
#     cpu_results[algo] = run_cpu_bench(algo)
#     @info "  done" success=round(cpu_results[algo].success_rate[end], digits = 3)
# end

pso_results = Dict{String, Any}()
for algo in pso_labels
    @info "Running $algo ..."
    try
        pso_results[algo] = run_pso_bench(algo)
        @info "  done" success=round(pso_results[algo].success_rate[end], digits = 3)
    catch err
        @warn "$algo failed, skipping" exception=(err, catch_backtrace())
    end
end

available_pso = [l for l in pso_labels if haskey(pso_results, l)]
@info "Completed" n=length(available_pso) labels=available_pso
```

## Success Rate vs. Iterations
```julia
all_sr_end = [pso_results[l].success_rate[end] for l in available_pso]
idx = sortperm(all_sr_end, rev = true)
for i in idx
    @info available_pso[i] success_rate=round(all_sr_end[i], digits = 4)
end
```

## Test all (wall-clock time to success)
```julia
tts_results = Dict{String, Vector{Float64}}()

# for algo in cpu_labels
#     @info "TTS: $algo ..."
#     tts_results[algo] = run_cpu_tts(algo)
# end

for algo in available_pso
    tts_results[algo] = extract_tts(pso_results[algo])
end
```

## Success Rate vs. Wall-Clock Time
```julia
all_finite = filter(isfinite, vcat(values(tts_results)...))
if !isempty(all_finite)
    t_lo = minimum(all_finite) / 2
    t_hi = maximum(all_finite) * 2
    time_thresholds = 10 .^ range(log10(t_lo), log10(t_hi), length = 50)

    cdfs = Dict(algo => success_rate_cdf(tts_results[algo], time_thresholds) for algo in available_pso)
    idx = sortperm([cdfs[l][end] for l in available_pso], rev = true)
    for i in idx
        @info available_pso[i] wall_clock_success=round(cdfs[available_pso[i]][end], digits = 4)
    end
else
    @warn "No successful solves — cannot build CDF"
end
```

## Success Rate per Function Heatmap
```julia
if !isempty(available_pso)
    pso_srpf = reduce(hcat, pso_results[l].success_rate_per_function for l in available_pso)

    for (i, l) in enumerate(available_pso)
        @info l per_func_success=round.(pso_srpf[:, i], digits = 2)
    end
end
```

## Distance to Minimizer vs. Iterations
```julia
if !isempty(available_pso)
    all_dtm_end = [pso_results[l].distance_to_minimizer[end] for l in available_pso]
    idx = sortperm(all_dtm_end, rev = false)
    for i in idx
        @info available_pso[i] dist_to_min=round(all_dtm_end[i], digits = 4)
    end
end
```

## Relative Runtime
```julia
if !isempty(available_pso)
    all_runtimes = [pso_results[l].runtime for l in available_pso]
    ref_rt = minimum(all_runtimes)
    all_runtimes_rel = all_runtimes ./ ref_rt

    idx = sortperm(all_runtimes_rel)
    for i in idx
        @info available_pso[i] relative_runtime="$(round(all_runtimes_rel[i], digits = 2))x"
    end
end
```